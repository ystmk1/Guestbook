{
  "name": "sympoiesis-guestbook",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "model": "gltf-transform resize \"$npm_config_src\" /tmp/_r.glb --width 2048 --height 2048 && gltf-transform webp /tmp/_r.glb /tmp/_w.glb --quality 82 && gltf-transform meshopt /tmp/_w.glb public/model.glb",
    "bg": "node -e \"const{execFileSync}=require('child_process');const[a,b]=process.argv.slice(1);execFileSync(require('ffmpeg-static'),['-y','-i',a,'-i',b,'-filter_complex','[0:v]scale=1280:720:flags=lanczos,fps=24,hue=s=0,setsar=1[a];'+'[1:v]scale=1280:720:flags=lanczos,fps=24,hue=s=0,setsar=1[b];'+'[a][b]xfade=transition=fade:duration=1:offset='+(process.env.npm_config_offset||29.6)+'[v]','-map','[v]','-an','-c:v','libx264','-preset','slow','-crf','33','-pix_fmt','yuv420p','-movflags','+faststart','public/bg.mp4'],{stdio:'inherit'})\" --",
    "font": "python scripts/build-font.py \"SM3신중고딕-03.otf\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.0",
    "@types/three": "^0.169.0",
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.35.4",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
